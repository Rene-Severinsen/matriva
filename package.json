{
  "name": "matriva",
  "version": "0.1.0",
  "private": true,
  "description": "Matriva 2.0 clean-sheet monorepo.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run build:packages && npm run start -w @matriva/mobile",
    "dev:api": "npm run build -w @matriva/shared && DATABASE_URL=${DATABASE_URL:-postgresql://matriva:matriva_dev_password@127.0.0.1:56432/matriva_dev} npm run dev -w @matriva/api",
    "dev:admin": "npm run build:packages && npm run dev -w @matriva/admin",
    "admin:hash-password": "node tools/admin-hash-password.mjs",
    "build": "npm run build:packages && npm run build -w @matriva/api && npm run build -w @matriva/admin && npm run build -w @matriva/website",
    "build:admin": "npm run build:packages && npm run build -w @matriva/admin",
    "build:packages": "npm run build -w @matriva/shared && npm run build -w @matriva/api-client",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present",
    "lint": "npm run build:packages && npm run lint --workspaces --if-present",
    "check:no-firebase": "node tools/check-no-firebase.mjs",
    "check:secrets": "node tools/check-no-secrets.mjs",
    "check:bbr-public-data-parity": "node tools/check-bbr-public-data-parity.mjs",
    "check:bbr:parity": "npm run check:bbr-public-data-parity",
    "smoke:api:dev": "node tools/smoke-api-dev.mjs",
    "smoke:api:routes": "node tools/smoke-api-routes.mjs",
    "smoke:admin": "node tools/smoke-admin.mjs",
    "preview:dev-fixture-cleanup": "node tools/preview-dev-fixture-cleanup.mjs",
    "screenshot:dev-fixture": "node tools/screenshot-dev-fixture.mjs",
    "smoke:maintenance": "node tools/smoke-maintenance.mjs",
    "smoke:storage": "node tools/smoke-storage.mjs",
    "smoke:bbr": "npm run build && node tools/smoke-bbr-public-data.mjs",
    "smoke:public-data:product": "npm run build && node tools/smoke-public-data-product.mjs",
    "smoke:bbr:live": "npm run build && node tools/smoke-bbr-live.mjs",
    "smoke:bbr:live:complex": "npm run build && node tools/smoke-bbr-live-complex.mjs",
    "check": "npm run check:no-firebase && npm run check:secrets && npm run check:bbr-codebooks && npm run check:bbr-public-data-parity && npm run typecheck && npm run lint",
    "test:entitlements-contract": "npm run build -w @matriva/shared && node --test tools/test-entitlements-contract.mjs",
    "test:recommendation-applicability": "node --experimental-strip-types --test tools/test-recommendation-applicability-v1.mjs",
    "test:mobile-app-identity": "node --experimental-strip-types --test tools/test-mobile-app-identity.mjs",
    "test:mobile-api-compatibility": "npm run build:packages && node --experimental-strip-types --test tools/test-mobile-api-compatibility.mjs",
    "smoke:auth": "node tools/smoke-auth.mjs",
    "test:house-invitation-entitlements": "node tools/smoke-house-invitation-entitlements.mjs",
    "test:house-membership-removal": "node tools/smoke-house-membership-removal.mjs",
    "test:house-default-selection": "node tools/smoke-house-default-selection.mjs",
    "db:reset-test": "node tools/reset-test-db.mjs",
    "db:reset-qa-user-house-data": "node tools/reset-qa-user-house-data.mjs",
    "test:qa-reset-order": "node tools/test-qa-user-house-reset-order.mjs",
    "check:bbr-codebooks": "node tools/check-bbr-codebooks.mjs",
    "generate:house-a-geometry": "node tools/generate-house-a-canonical-geometry.mjs",
    "test:house-a-geometry": "node tools/test-house-a-canonical-geometry.mjs",
    "generate:house-a-previews": "node tools/generate-house-a-geometric-previews.mjs",
    "test:house-a-previews": "node tools/test-house-a-geometric-previews.mjs",
    "generate:house-a-pilot-board": "node tools/generate-house-a-photorealistic-pilot-board.mjs",
    "test:house-a-photorealistic-pilot": "node tools/test-house-a-photorealistic-pilot.mjs",
    "test:house-a-pilot-board": "node tools/test-house-a-photorealistic-pilot-board.mjs",
    "generate:house-a-a04-a05-board": "node tools/generate-house-a-a04-a05-approval-board.mjs",
    "test:house-a-a04-a05-board": "node tools/test-house-a-a04-a05-approval-board.mjs",
    "generate:house-a-masonry-history": "node tools/generate-house-a-masonry-test.mjs",
    "test:house-a-masonry-history": "node tools/test-house-a-masonry-test.mjs",
    "test:house-a-material-specification": "node tools/test-house-a-material-specification.mjs",
    "test:house-a-landscape-specification": "node tools/test-house-a-landscape-specification.mjs",
    "test:house-a-bathroom-reference": "node tools/test-house-a-bathroom-reference.mjs",
    "test:guide02-runtime": "node tools/test-guide02-runtime.mjs",
    "test:guide-asset-delivery": "npm run build -w @matriva/api && node tools/test-guide-asset-delivery.mjs",
    "backfill:guide-asset-variants": "node tools/backfill-guide-asset-variants.mjs",
    "test:storage-policy": "npm run build -w @matriva/api && node tools/test-storage-policy.mjs",
    "verify:qa-runtime": "node tools/verify-qa-runtime.mjs",
    "deploy:qa": "bash infra/hetzner/deploy-qa.sh",
    "generate:house-a-a01-facade-board": "node tools/generate-house-a-a01-rendered-facade-validation-board.mjs",
    "test:house-a-a01-facade-board": "node tools/test-house-a-a01-rendered-facade-validation-board.mjs",
    "generate:house-a-a01-garden-board": "node tools/generate-house-a-a01-natural-garden-test-board.mjs",
    "test:house-a-a01-garden-board": "node tools/test-house-a-a01-natural-garden-test-board.mjs",
    "generate:house-a-rendered-garden-board": "node tools/generate-house-a-rendered-facade-natural-garden-board.mjs",
    "test:house-a-rendered-garden": "node tools/test-house-a-rendered-facade-natural-garden.mjs",
    "promote:house-a-canonical-renders": "node tools/promote-house-a-canonical-renders.mjs",
    "test:house-a-canonical-renders": "node tools/test-house-a-canonical-renders.mjs",
    "dev:website": "npm run dev -w @matriva/website",
    "build:website": "npm run build -w @matriva/website"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
