DATABASE_URL=
# Recommended values: local, qa, production
MATRIVA_ENVIRONMENT=local
MATRIVA_S3_ENDPOINT=
MATRIVA_S3_REGION=
MATRIVA_S3_BUCKET=
MATRIVA_S3_ACCESS_KEY_ID=
MATRIVA_S3_SECRET_ACCESS_KEY=
MATRIVA_S3_FORCE_PATH_STYLE=true
MATRIVA_S3_PRIVATE_OBJECTS=true
MATRIVA_MAINTENANCE_ATTACHMENT_MAX_BYTES=15728640
MATRIVA_ATTACHMENT_STORAGE_DIR=
# local is for local/dev/test only; QA and production must use s3.
MATRIVA_STORAGE_ADAPTER=local
# Set false to keep in-app notifications active without contacting Expo Push Service.
MATRIVA_PUSH_ENABLED=true
# Notification deadline/outbox worker interval. Minimum is 60000 ms.
MATRIVA_NOTIFICATION_INTERVAL_MS=300000
# IANA timezone used when calculating due-today windows.
MATRIVA_NOTIFICATION_TIME_ZONE=Europe/Copenhagen

# Optional, explicit mobile compatibility policy. Leave unset to keep all
# clients backward compatible by default. These values are not inferred from
# schema changes or deployments.
# MATRIVA_MIN_SUPPORTED_APP_VERSION=1.0.0
# MATRIVA_MIN_SUPPORTED_APP_BUILD=100
# MATRIVA_APP_UPDATE_URL=https://apps.apple.com/app/id...
