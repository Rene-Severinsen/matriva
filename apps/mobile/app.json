{
  "expo": {
    "name": "Matriva",
    "slug": "matriva",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dk.matriva.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "dk.matriva.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "api-qa.matriva.dk",
              "pathPrefix": "/v1/auth/magic-link/open"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F3F6F4"
      }
    },
    "extra": {
      "apiBaseUrl": "http://localhost:4000",
      "eas": {
        "projectId": "5aaec5f2-9f31-470c-9fc3-ae4ba5054f22"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "scheme": "matriva",
    "owner": "joinitdk",
    "icon": "./assets/icon.png"
  }
}
